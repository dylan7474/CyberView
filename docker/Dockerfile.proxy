# HTTPS front door for the portal: nginx from Debian 13, with a self-signed certificate made on first start.
FROM debian:trixie-slim
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nginx openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/proxy-entrypoint.sh /usr/local/bin/proxy-entrypoint.sh
RUN chmod +x /usr/local/bin/proxy-entrypoint.sh
EXPOSE 80 443
ENTRYPOINT ["/usr/local/bin/proxy-entrypoint.sh"]
